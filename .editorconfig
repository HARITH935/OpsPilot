# https://editorconfig.org — shared formatting rules every editor/IDE respects
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Java and Python conventionally use 4 spaces
[*.{java,py}]
indent_size = 4

# Makefiles require real tabs
[Makefile]
indent_style = tab

# Trailing double-space is a line break in Markdown
[*.md]
trim_trailing_whitespace = false
