<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.opspilot</groupId>
        <artifactId>opspilot-services</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <!-- A plain library (a normal .jar): no Spring Boot app, no web server, no database.
         So it has no spring-boot-maven-plugin, unlike the services. -->
    <artifactId>common-events</artifactId>
    <name>common-events</name>
    <description>Event envelope, saga event records and their JSON format, shared by all services</description>

    <dependencies>
        <!-- Jackson 3: turns the event records into JSON and back (version managed by the Spring Boot parent) -->
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <!-- Only JUnit + AssertJ for tests: there is no Spring here to start -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
