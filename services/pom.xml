<?xml version="1.0" encoding="UTF-8"?>
<!-- Parent POM: shared settings for every OpsPilot Java service. Each service lists it as <parent>. -->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Inherit Spring Boot's tested library versions and plugin defaults -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.2</version>
        <relativePath/>
    </parent>

    <groupId>com.opspilot</groupId>
    <artifactId>opspilot-services</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <!-- "pom" = this project holds no code itself; it only groups the modules below -->
    <packaging>pom</packaging>
    <name>OpsPilot services</name>

    <properties>
        <java.version>21</java.version>
    </properties>

    <!-- Built together, in dependency order, by ./mvnw verify -->
    <modules>
        <module>order-service</module>
    </modules>
</project>
