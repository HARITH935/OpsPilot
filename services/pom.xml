<?xml version="1.0" encoding="UTF-8"?>
<!-- Parent POM: shared settings for every OpsPilot Java service. Each service lists it as <parent>. -->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Inherit Spring Boot's tested library versions and plugin defaults -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.2</version>
        <relativePath/>
    </parent>

    <groupId>com.opspilot</groupId>
    <artifactId>opspilot-services</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <!-- "pom" = this project holds no code itself; it only groups the modules below -->
    <packaging>pom</packaging>
    <name>OpsPilot services</name>

    <properties>
        <java.version>21</java.version>
        <resilience4j.version>2.3.0</resilience4j.version>
    </properties>

    <!-- Versions only (nothing is added to a module until it lists the dependency itself) -->
    <dependencyManagement>
        <dependencies>
            <!-- Resilience4j (timeouts, retries, circuit breakers, bulkheads): one version for every module.
                 2.3.0 is also what the gateway's Spring Cloud BOM picks. -->
            <dependency>
                <groupId>io.github.resilience4j</groupId>
                <artifactId>resilience4j-bom</artifactId>
                <version>${resilience4j.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!-- Built together, in dependency order, by ./mvnw verify -->
    <modules>
        <module>common-events</module>      <!-- first: everything else depends on it -->
        <module>common-messaging</module>   <!-- the outbox; uses common-events, used by the services -->
        <module>order-service</module>
        <module>inventory-service</module>
        <module>payment-service</module>
        <module>api-gateway</module>        <!-- last: the front door to the three services (no code dependency on them) -->
    </modules>
</project>
