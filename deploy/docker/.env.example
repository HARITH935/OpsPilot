# Copy to .env (same folder) and set real values. .env is gitignored — never commit it.
# Generate a password:  openssl rand -base64 24

# Postgres superuser (admin only — services never use it)
POSTGRES_PASSWORD=change-me
# One login per service database
ORDERS_DB_PASSWORD=change-me
INVENTORY_DB_PASSWORD=change-me
PAYMENTS_DB_PASSWORD=change-me

# Shared password of the API gateway's demo users (viewer / engineer / admin, POST /auth/token): local development
# and evals only, used when the gateway runs with DEMO_USERS_ENABLED=true. At least 12 characters.
DEMO_USERS_PASSWORD=change-me

# Redis (rate-limit counters in the API gateway, product cache in inventory-service). Given to both as REDIS_PASSWORD.
REDIS_PASSWORD=change-me

# Host port for Postgres (change if 5432 is already used on your machine)
POSTGRES_PORT=5432
